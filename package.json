{
  "name": "mavi-matematik-macerasi",
  "version": "1.1.0",
  "private": true,
  "description": "Mavi'nin Matematik Macerası — Türkçe eğitici platform oyunu (PWA)",
  "scripts": {
    "serve": "python3 -m http.server 8081 --bind 127.0.0.1",
    "build": "node tools/build.mjs",
    "preview": "node tools/preview.mjs --port 4173",
    "preview:subpath": "node tools/preview.mjs --port 4173 --base /mavi-matematik-macerasi/",
    "test": "playwright test",
    "test:dist": "playwright test --project dist-pwa-telefon",
    "test:headed": "playwright test --headed",
    "release": "npm test && npm run build",
    "validate:levels": "node tools/validate-levels.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
